<?xml version="1.0" encoding="UTF-8"?>
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="border"
	titleFont="SansSerif,0,12" darkLevel="0"
	dataClassName="org.openflexo.technologyadapter.powerpoint.model.PowerpointChart"
	controllerClassName="org.openflexo.inspector.FIBInspectorController"
	font="SansSerif,0,12" name="Inspector">
	<TabPanel name="Tab" constraints="border(location=center)">
		<Tab title="Basic" layout="twocols" titleFont="SansSerif,0,11"
			darkLevel="0" index="0" font="SansSerif,0,11" useScrollBar="true"
			horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
			verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED" name="BasicTab">
			<Label label="title" index="1200" localize="true" name="ChartTitleLabel"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=1200;location=left)" />
			<TextField index="1200" data="data.title" readOnly="true" columns="10" localize="true" name="ChartTitle"
				constraints="twocols(expandHorizontally=true;expandVertically=false;index=1200;location=right)" />
			<Label label="chart_type" index="1201" localize="true" name="ChartTypeLabel"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=1201;location=left)" />
			<TextField index="1201" data="data.chartType" readOnly="true" columns="10" localize="true" name="ChartType"
				constraints="twocols(expandHorizontally=true;expandVertically=false;index=1201;location=right)" />
			<Label label="series" index="1202" localize="true" name="SeriesCountLabel"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=1202;location=left)" />
			<Number numberType="IntegerType" index="1202" data="data.series.size" readOnly="true" columns="10" localize="true" name="SeriesCount"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=1202;location=right)" />
		</Tab>
	</TabPanel>
	<LocalizedDictionary>
		<Localized key="title" lang="English" value="title" />
		<Localized key="title" lang="French" value="titre" />
		<Localized key="chart_type" lang="English" value="kind of chart" />
		<Localized key="chart_type" lang="French" value="type de graphique" />
		<Localized key="series" lang="English" value="series" />
		<Localized key="series" lang="French" value="séries" />
	</LocalizedDictionary>
	<Parameter name="title" value="Chart" />
</Panel>
