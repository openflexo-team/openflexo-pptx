<?xml version="1.0" encoding="UTF-8"?>
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="border"
	titleFont="SansSerif,0,12" darkLevel="0"
	dataClassName="org.openflexo.technologyadapter.powerpoint.model.PowerpointObject"
	controllerClassName="org.openflexo.inspector.FIBInspectorController"
	font="SansSerif,0,12" name="Inspector">
	<TabPanel name="Tab" constraints="border(location=center)">
		<Tab title="Basic" layout="twocols" titleFont="SansSerif,0,11"
			darkLevel="0" index="0" font="SansSerif,0,11" useScrollBar="true"
			horizontalScrollbarPolicy="HORIZONTAL_SCROLLBAR_AS_NEEDED"
			verticalScrollbarPolicy="VERTICAL_SCROLLBAR_AS_NEEDED" name="BasicTab">
			<Label label="name" index="0" localize="true" name="NameLabel"
				constraints="twocols(expandHorizontally=false;expandVertically=false;index=0;location=left)" />
			<TextField index="0" data="data.name" readOnly="true" columns="10" localize="true" name="Name"
				constraints="twocols(expandHorizontally=true;expandVertically=false;index=0;location=right)" />
		</Tab>
	</TabPanel>
	<LocalizedDictionary>
		<Localized key="name" lang="English" value="name" />
		<Localized key="name" lang="French" value="nom" />
	</LocalizedDictionary>
	<Parameter name="title" value="PowerPoint object" />
</Panel>
